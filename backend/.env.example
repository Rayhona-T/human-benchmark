# Copy to backend/.env to override defaults. backend/.env is git-ignored.
# Every value below is the default; none of these is a secret.

# Only "development" or "test" are accepted until deployment blockers are
# resolved (docs/backend/BACKEND_ARCHITECTURE.md section 9).
HB_ENV=development

# Local-owner access: list, read and delete stored sessions (Cycle 9).
# Off by default; effective only with HB_ENV=development. Not ownership proof:
# while true, anyone on this computer can read and delete every session.
HB_LOCAL_OWNER_ACCESS=false

# Default: a SQLite file at backend/human_benchmark.db (git-ignored), which on
# the development machine is inside OneDrive. Recommended: a path outside any
# synced folder (backend/README.md, "Database location").
# HB_DATABASE_URL=sqlite:///C:/Users/<username>/AppData/Local/HumanBenchmark/human_benchmark.db

# Comma-separated explicit origins; "*" is refused.
HB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Request body limit in bytes (1024 to 2097152).
HB_MAX_REQUEST_BYTES=262144

HB_HOST=127.0.0.1
HB_PORT=8000
HB_LOG_LEVEL=INFO
