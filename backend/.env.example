# Copy to backend/.env to override defaults. backend/.env is git-ignored.
# Every value below is the default; none of these is a secret.

# Only "development" or "test" are accepted until deployment blockers are
# resolved (docs/backend/BACKEND_ARCHITECTURE.md section 9).
HB_ENV=development

# Default: a SQLite file at backend/human_benchmark.db (git-ignored).
# HB_DATABASE_URL=sqlite:///C:/path/to/human_benchmark.db

# Comma-separated explicit origins; "*" is refused.
HB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Request body limit in bytes (1024 to 2097152).
HB_MAX_REQUEST_BYTES=262144

HB_HOST=127.0.0.1
HB_PORT=8000
HB_LOG_LEVEL=INFO
